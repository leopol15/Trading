//@version=5
// MSB + Liquidity Sweep + Michael's Bands  (H1)
// Same rules as msb_liq/strategy.py. Defaults = crypto settings (msb_liq/crypto.py).
// Load on a 1H chart of a USDT perpetual (e.g. ETHUSDT.P / XRPUSDT.P).
// Session times are in Plovdiv local time (Europe/Sofia).
strategy("MSB + Liq + Michael's Bands", overlay=true, initial_capital=1000, currency=currency.EUR,
     default_qty_type=strategy.fixed, commission_type=strategy.commission.percent, commission_value=0.07,
     slippage=1, process_orders_on_close=false, calc_on_every_tick=false)

// ---------- inputs ----------
bandFast  = input.int(21, "Michael's band - fast EMA")
bandSlow  = input.int(50, "Michael's band - slow EMA")
swingLen  = input.int(5,  "Swing length (pivot left/right)")
msbWindow = input.int(5,  "Bars allowed between sweep and MSB")
rr        = input.float(2.0, "Take profit (R)")
riskPct   = input.float(1.0, "Risk per trade (% of equity)")
slBufAtr  = input.float(0.1, "Stop buffer (x ATR)")
minRisk   = input.float(0.5, "Min stop size (x ATR)")
maxRisk   = input.float(3.0, "Max stop size (x ATR)")
minStopPc = input.float(1.0, "Min stop size (% of price) - keeps fees small vs R")
maxLev    = input.float(5.0, "Max leverage (position notional / equity)")
closeSess = input.bool(false, "Close trades at session end (off = SL/TP stay on overnight)")
maxPerDay = input.int(2, "Max trades per day")
startH    = input.int(9,  "First entry hour (Plovdiv)")
endH      = input.int(22, "No new entries from hour (Plovdiv)")
flatH     = input.int(23, "Close everything at hour (Plovdiv)")
tz        = "Europe/Sofia"

// ---------- indicators ----------
f   = ta.ema(close, bandFast)
s   = ta.ema(close, bandSlow)
a   = ta.atr(14)
p1  = plot(f, "Band fast", color=color.new(color.teal, 0))
p2  = plot(s, "Band slow", color=color.new(color.orange, 0))
fill(p1, p2, color=f > s ? color.new(color.teal, 80) : color.new(color.red, 80))

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
var float swingHigh = na
var float swingLow  = na
if not na(ph)
    swingHigh := ph
if not na(pl)
    swingLow := pl

// ---------- liquidity sweeps ----------
var int   bullSweepBar = na
var float bullSweepLow = na
var int   bearSweepBar = na
var float bearSweepHigh = na

if not na(swingLow) and low < swingLow and close > swingLow
    if na(bullSweepBar) or bar_index - bullSweepBar > msbWindow or low < bullSweepLow
        bullSweepBar := bar_index
        bullSweepLow := low
if not na(swingHigh) and high > swingHigh and close < swingHigh
    if na(bearSweepBar) or bar_index - bearSweepBar > msbWindow or high > bearSweepHigh
        bearSweepBar := bar_index
        bearSweepHigh := high
if not na(bullSweepBar) and bar_index - bullSweepBar > msbWindow
    bullSweepBar := na
if not na(bearSweepBar) and bar_index - bearSweepBar > msbWindow
    bearSweepBar := na

// ---------- session ----------
h = hour(time, tz)
nextH = (h + 1) % 24
inWindow = nextH >= startH and nextH < endH
var int tradesToday = 0
if ta.change(dayofmonth(time, tz)) != 0
    tradesToday := 0
canTrade = strategy.position_size == 0 and inWindow and tradesToday < maxPerDay

// ---------- MSB signals ----------
longSig  = false
shortSig = false
float stopPx = na
if not na(bullSweepBar) and bar_index > bullSweepBar and close > swingHigh and close[1] <= swingHigh
    if canTrade and f > s
        longSig := true
        stopPx := bullSweepLow - slBufAtr * a
    bullSweepBar := na
else if not na(bearSweepBar) and bar_index > bearSweepBar and close < swingLow and close[1] >= swingLow
    if canTrade and f < s
        shortSig := true
        stopPx := bearSweepHigh + slBufAtr * a
    bearSweepBar := na

risk = math.abs(close - stopPx)
okRisk = risk >= minRisk * a and risk <= maxRisk * a and risk >= close * minStopPc / 100
qty = okRisk ? math.min(strategy.equity * riskPct / 100 / risk, strategy.equity * maxLev / close) : 0.0

if longSig and okRisk and stopPx < close
    strategy.entry("L", strategy.long, qty=qty)
    strategy.exit("L-x", "L", stop=stopPx, limit=close + rr * risk)
    tradesToday += 1
if shortSig and okRisk and stopPx > close
    strategy.entry("S", strategy.short, qty=qty)
    strategy.exit("S-x", "S", stop=stopPx, limit=close - rr * risk)
    tradesToday += 1

// flat before midnight
if closeSess and strategy.position_size != 0 and (h >= flatH or h < startH)
    strategy.close_all(comment="session end")

plotshape(longSig and okRisk,  "MSB long",  shape.triangleup,   location.belowbar, color.teal, size=size.small)
plotshape(shortSig and okRisk, "MSB short", shape.triangledown, location.abovebar, color.red,  size=size.small)
plot(swingHigh, "Last swing high (buy-side liq)",  color=color.new(color.gray, 40), style=plot.style_stepline)
plot(swingLow,  "Last swing low (sell-side liq)",  color=color.new(color.gray, 40), style=plot.style_stepline)
